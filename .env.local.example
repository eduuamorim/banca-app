# Copie este arquivo para .env.local e preencha.

# ─── Supabase (obrigatório) ───
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# ─── Leitura do bilhete (opcional) ───
# Escolha UMA. Se não puser nenhuma, o app lê o print
# direto no navegador com Tesseract, de graça.

# Google Gemini — camada gratuita, não pede cartão
# Pegue em https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Anthropic — pago, leitura mais precisa
# Pegue em https://console.anthropic.com
ANTHROPIC_API_KEY=

# Opcional: force um provedor ("gemini" ou "anthropic")
PROVEDOR_IA=

# Opcional: troque o modelo se o padrão parar de existir
GEMINI_MODELO=gemini-2.0-flash
